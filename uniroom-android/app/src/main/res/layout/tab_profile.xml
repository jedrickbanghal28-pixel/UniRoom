<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/profile_initials"
                style="@style/T.Display"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="?attr/uniPrimary"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/profile_name"
                style="@style/T.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/profile_role"
                style="@style/T.SmallInk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="?attr/uniPrimary" />
        </LinearLayout>

        <TextView
            style="@style/T.MetaSemi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="10dp"
            android:text="Account details"
            android:textColor="@color/muted" />

        <LinearLayout
            android:id="@+id/profile_details"
            style="@style/Card.List" />

        <LinearLayout
            android:id="@+id/btn_logout"
            style="@style/Btn.Danger"
            android:layout_marginTop="32dp">

            <ImageView
                style="@style/BtnIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_log_out"
                android:tint="@color/danger" />

            <TextView
                style="@style/BtnText.Danger"
                android:text="Log out" />
        </LinearLayout>

        <TextView
            style="@style/T.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="UniRoom v2.0" />
    </LinearLayout>
</ScrollView>

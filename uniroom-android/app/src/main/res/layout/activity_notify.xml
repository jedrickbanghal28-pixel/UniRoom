<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/status_spacer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== The form ===== -->
        <ScrollView
            android:id="@+id/form_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <include
                    android:id="@+id/header"
                    layout="@layout/view_back_header" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!-- Section -->
                    <TextView
                        android:id="@+id/section_label"
                        style="@style/Field.Label"
                        android:layout_marginBottom="8dp"
                        android:text="Send to *" />

                    <!-- Scrolls sideways if the chips do not fit on a small phone -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/section_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/section_error"
                        style="@style/Field.Error" />

                    <!-- Type -->
                    <TextView
                        style="@style/Field.Label"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:text="Type" />

                    <LinearLayout
                        android:id="@+id/type_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- From -> To (room change only) -->
                    <LinearLayout
                        android:id="@+id/transfer_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/f_from"
                            layout="@layout/view_select_field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="40dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_right"
                            android:tint="@color/muted" />

                        <include
                            android:id="@+id/f_to"
                            layout="@layout/view_select_field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <!-- Message -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/message_label"
                            style="@style/T.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/message_count"
                            style="@style/T.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/200" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/message_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_field"
                        android:gravity="top|start"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lines="4"
                        android:maxLength="200"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:singleLine="false" />

                    <TextView
                        android:id="@+id/message_error"
                        style="@style/Field.Error" />

                    <!-- Preview -->
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:text="Students will see"
                        android:textColor="@color/muted" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_outline_16"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/T.CaptionSemi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UniRoom · now"
                            android:textColor="@color/muted" />

                        <TextView
                            android:id="@+id/preview_title"
                            style="@style/T.BodySemi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/preview_body"
                            style="@style/T.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ===== "Notification sent" ===== -->
        <LinearLayout
            android:id="@+id/sent_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/sent_check"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/success_soft"
                android:importantForAccessibility="no"
                android:padding="17dp"
                android:src="@drawable/ic_check"
                android:tint="@color/success" />

            <TextView
                style="@style/T.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Notification sent" />

            <TextView
                android:id="@+id/sent_text"
                style="@style/T.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:id="@+id/btn_done"
                style="@style/Btn.Primary"
                android:layout_marginTop="32dp">

                <TextView
                    style="@style/BtnText.Primary"
                    android:text="Done" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_send_another"
                style="@style/Btn.Outline"
                android:layout_marginTop="10dp">

                <TextView
                    style="@style/BtnText.Outline"
                    android:text="Send another" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Sticky send button -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/canvas"
        android:orientation="vertical">

        <View
            android:id="@+id/footer_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/footer_inner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/btn_send"
                style="@style/Btn.Primary">

                <ProgressBar
                    android:id="@+id/send_spinner"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/send_label"
                    style="@style/BtnText.Primary"
                    android:text="Send notification" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

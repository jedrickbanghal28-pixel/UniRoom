<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/rd_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/rd_type"
            style="@style/T.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            style="@style/T.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Used by " />

        <TextView
            android:id="@+id/rd_department"
            style="@style/T.MetaInk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium" />
    </LinearLayout>

    <!-- Building | Floor | Capacity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_canvas_16"
        android:divider="@drawable/divider"
        android:orientation="horizontal"
        android:showDividers="middle">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Building" />

            <TextView
                android:id="@+id/rd_building"
                style="@style/T.BodySemi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Floor" />

            <TextView
                android:id="@+id/rd_floor"
                style="@style/T.BodySemi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Capacity" />

            <TextView
                android:id="@+id/rd_capacity"
                style="@style/T.BodySemi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- View room location -->
    <LinearLayout
        android:id="@+id/rd_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_outline_16"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/ripple_round_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/rd_location_image"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:outlineProvider="background"
            android:background="@drawable/bg_round_12"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/T.SmallSemi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View room location" />

            <TextView
                android:id="@+id/rd_location_landmark"
                style="@style/T.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/muted" />
    </LinearLayout>

    <TextView
        style="@style/T.SmallSemi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Today in this room" />

    <TextView
        android:id="@+id/rd_today_none"
        style="@style/T.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="No classes scheduled here today."
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rd_today_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:divider="@drawable/divider"
        android:orientation="vertical"
        android:showDividers="middle" />

    <LinearLayout
        android:id="@+id/rd_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>

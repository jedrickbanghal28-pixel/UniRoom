<?xml version="1.0" encoding="utf-8"?>
<!-- One day in the schedule's week strip -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_weight="1"
    android:background="@drawable/bg_round_16"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_round_16"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/chip_day"
        style="@style/T.Tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/chip_date"
        style="@style/T.BodySemi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp" />

    <View
        android:id="@+id/chip_dot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_circle" />
</LinearLayout>

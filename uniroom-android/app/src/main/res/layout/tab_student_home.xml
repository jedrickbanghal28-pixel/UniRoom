<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Coloured header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/uniPrimary"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_date"
                    style="@style/T.SmallInk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white_70" />

                <TextView
                    android:id="@+id/home_greeting"
                    style="@style/T.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/home_context"
                    style="@style/T.SmallInk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white_70" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/home_bell"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ripple_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/white_15"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_bell"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/home_badge"
                    style="@style/T.Tiny"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_pill"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="?attr/uniPrimary"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Content that overlaps the header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-64dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include
                android:id="@+id/next_card"
                layout="@layout/view_next_class" />

            <!-- Latest unread alert -->
            <LinearLayout
                android:id="@+id/home_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_warning_banner"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_round_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_right_left"
                    android:tint="@color/warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_alert_title"
                        style="@style/T.SmallSemi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/home_alert_meta"
                        style="@style/T.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/muted" />
            </LinearLayout>

            <!-- Later today -->
            <LinearLayout
                android:id="@+id/later_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeading"
                    android:text="Later today" />

                <LinearLayout
                    android:id="@+id/later_list"
                    style="@style/Card.List" />
            </LinearLayout>

            <!-- Rooms this week -->
            <TextView
                style="@style/SectionHeading"
                android:layout_marginTop="24dp"
                android:text="Your rooms this week" />

            <LinearLayout
                android:id="@+id/week_list"
                style="@style/Card.List" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

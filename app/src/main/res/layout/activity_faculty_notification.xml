<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Student Notification"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#85180F"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notify a section about room changes or important updates."
            android:textSize="15sp"
            android:textColor="#777777"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Section"
            android:textStyle="bold"
            android:textColor="#252B3A"/>

        <Spinner
            android:id="@+id/sectionSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:background="#FFFFFF"/>

        <EditText
            android:id="@+id/roomFromInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Current Room (e.g. TH 309)"
            android:inputType="text"
            android:padding="12dp"
            android:background="#FFFFFF"/>

        <EditText
            android:id="@+id/roomToInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint="Transfer Room (e.g. TH 311)"
            android:inputType="text"
            android:padding="12dp"
            android:background="#FFFFFF"/>

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:hint="Notification message"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:background="#FFFFFF"/>

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp"
            android:text="SEND NOTIFICATION"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#85180F"/>

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="BACK"
            android:backgroundTint="#777777"/>

    </LinearLayout>

</ScrollView>
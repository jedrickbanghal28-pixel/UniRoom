# Copy this file to ".env" for local testing.
# On Vercel: Project → Settings → Environment Variables (same names).

# --- Supabase database (Project Settings → Database → Connection string → Transaction pooler) ---
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# --- Security ---
# Any long random text. It signs the login tokens.
APP_SECRET=replace-with-a-long-random-string

# --- Websites ---
# Your admin website on Vercel (used for the "Set my password" link in emails)
ADMIN_WEB_URL=https://uniroom-admin.vercel.app
# Which websites may call the API from a browser (comma separated)
ALLOWED_ORIGINS=https://uniroom-admin.vercel.app,http://localhost:5500,http://127.0.0.1:5500

# --- Gmail (for account emails) ---
# SMTP_PASS is a Google "App password" (Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=youraccount@gmail.com
SMTP_PASS=abcdabcdabcdabcd
MAIL_FROM_NAME=UNIROOM

# Password setup links expire after this many hours
SETUP_LINK_HOURS=48
